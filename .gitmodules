[submodule "acetele/deploy/realsense-ros"]
	path = acetele/deploy/realsense-ros
	url = https://github.com/realsenseai/realsense-ros.git
[submodule "acetele/deploy/px4_ros2_ctrl"]
	path = acetele/deploy/px4_ros2_ctrl
	url = git@github.com:NextFlightLab/px4_ros2_ctrl.git
	ignore = untracked
[submodule "acetele/simulation/px4_sim_ros2/px4_msgs"]
	path = acetele/simulation/third_party/px4_msgs
	url = https://github.com/PX4/px4_msgs.git
	ignore = dirty
[submodule "acetele/simulation/PX4-Autopilot"]
	path = acetele/simulation/third_party/PX4-Autopilot
	url = https://github.com/PX4/PX4-Autopilot.git
	ignore = untracked
[submodule "acetele/simulation/Micro-XRCE-DDS-Agent"]
	path = acetele/simulation/third_party/Micro-XRCE-DDS-Agent
	url = https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
